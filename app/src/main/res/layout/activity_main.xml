<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="MAD Animation Practical 1"
        android:textSize="22sp"
        android:textColor="#1A1A1A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivAlarm"
        android:layout_width="0dp"
        android:layout_height="270dp"
        android:layout_marginTop="16dp"
        android:contentDescription="To Do"
        android:scaleType="centerInside"
        android:background="@drawable/alarm_frame_anim"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1EFFB"
        app:layout_constraintTop_toBottomOf="@id/ivAlarm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Alarm Time"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDesc1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="By pressing buttons, Alarm can be created and cancelled"
                android:textSize="15sp"
                android:textColor="#444444"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCardTitle" />

            <TextView
                android:id="@+id/tvDesc2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Check Current time by looking below real digital clock"
                android:textSize="15sp"
                android:textColor="#444444"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivHeart"
                app:layout_constraintTop_toBottomOf="@id/tvDesc1" />

            <ImageView
                android:id="@+id/ivHeart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ic_heart_outline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDesc2"
                app:layout_constraintBottom_toBottomOf="@id/tvDesc2" />

            <Button
                android:id="@+id/btnCreateAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Create Alarm"
                android:textAllCaps="false"
                android:backgroundTint="#6E8AF0"
                android:textColor="@android:color/white"
                app:cornerRadius="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnCancelAlarm"
                app:layout_constraintTop_toBottomOf="@id/tvDesc2"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <Button
                android:id="@+id/btnCancelAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cancel Alarm"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:textColor="#6E8AF0"
                app:layout_constraintStart_toEndOf="@id/btnCreateAlarm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnCreateAlarm"
                app:layout_constraintBottom_toBottomOf="@id/btnCreateAlarm" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>